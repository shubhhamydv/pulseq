{
  "title": "Pulse-Q Overview",
  "uid": "pulse-q-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "timezone": "browser",
  "tags": ["pulse-q", "jobs", "observability"],
  "templating": {"list": []},
  "panels": [
    {"id":1,"type":"stat","title":"Jobs processed","gridPos":{"h":4,"w":6,"x":0,"y":0},"targets":[{"expr":"sum(increase(jobs_completed_total[$__rate_interval]))","refId":"A"}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]}},
    {"id":2,"type":"stat","title":"Jobs failed","gridPos":{"h":4,"w":6,"x":6,"y":0},"targets":[{"expr":"sum(increase(jobs_failed_total[$__rate_interval]))","refId":"A"}],"fieldConfig":{"defaults":{"unit":"short","color":{"mode":"thresholds"},"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":1}]}},"overrides":[]}},
    {"id":3,"type":"stat","title":"Queue depth","gridPos":{"h":4,"w":6,"x":12,"y":0},"targets":[{"expr":"scheduler_queue_depth","refId":"A"}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]}},
    {"id":4,"type":"stat","title":"Active jobs","gridPos":{"h":4,"w":6,"x":18,"y":0},"targets":[{"expr":"scheduler_active_jobs","refId":"A"}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]}},
    {"id":5,"type":"timeseries","title":"Job execution latency","gridPos":{"h":8,"w":12,"x":0,"y":4},"targets":[{"expr":"histogram_quantile(0.50, sum by (le) (rate(job_execution_latency_seconds_bucket[$__rate_interval])))","legendFormat":"p50","refId":"A"},{"expr":"histogram_quantile(0.95, sum by (le) (rate(job_execution_latency_seconds_bucket[$__rate_interval])))","legendFormat":"p95","refId":"B"},{"expr":"histogram_quantile(0.99, sum by (le) (rate(job_execution_latency_seconds_bucket[$__rate_interval])))","legendFormat":"p99","refId":"C"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"id":6,"type":"timeseries","title":"API request rate","gridPos":{"h":8,"w":12,"x":12,"y":4},"targets":[{"expr":"sum by (route) (rate(scheduler_http_requests_total[$__rate_interval]))","legendFormat":"{{route}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]}},
    {"id":7,"type":"timeseries","title":"API error rate","gridPos":{"h":8,"w":12,"x":0,"y":12},"targets":[{"expr":"sum(rate(scheduler_http_requests_total{status_code=~\"5..\"}[$__rate_interval])) / sum(rate(scheduler_http_requests_total[$__rate_interval]))","legendFormat":"5xx ratio","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percentunit"},"overrides":[]}},
    {"id":8,"type":"timeseries","title":"Node.js memory","gridPos":{"h":8,"w":12,"x":12,"y":12},"targets":[{"expr":"scheduler_process_resident_memory_bytes","legendFormat":"RSS","refId":"A"},{"expr":"scheduler_nodejs_heap_size_used_bytes","legendFormat":"heap used","refId":"B"}],"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[]}},
    {"id":9,"type":"timeseries","title":"Worker activity","gridPos":{"h":8,"w":12,"x":0,"y":20},"targets":[{"expr":"scheduler_active_jobs","legendFormat":"active jobs","refId":"A"},{"expr":"scheduler_worker_count","legendFormat":"workers","refId":"B"}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]}},
    {"id":10,"type":"timeseries","title":"Node.js event-loop lag","gridPos":{"h":8,"w":12,"x":12,"y":20},"targets":[{"expr":"scheduler_nodejs_eventloop_lag_p99_seconds","legendFormat":"p99 lag","refId":"A"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}}
  ]
}
