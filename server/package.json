{
  "name": "server",
  "version": "0.0.1",
  "description": "Backend API for Distributed Job Scheduler",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --loader ts-node/esm --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "test": "node --env-file=.env --env-file=../.env --loader ts-node/esm --test --test-concurrency=1 tests/*.test.ts",
    "redis:health": "node --loader ts-node/esm -e \"import('./src/infrastructure/redis/redis.service.js').then(async ({ redisService }) => { console.log(await redisService.ping()); await redisService.disconnect(); })\""
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.203.0",
    "@opentelemetry/instrumentation": "^0.203.0",
    "@opentelemetry/instrumentation-express": "^0.52.0",
    "@opentelemetry/instrumentation-http": "^0.203.0",
    "@opentelemetry/instrumentation-ioredis": "^0.51.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-node": "^0.203.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "@prisma/client": "^6.14.0",
    "cron-parser": "^4.9.0",
    "express": "^4.18.2",
    "ioredis": "^5.4.1",
    "pino": "^9.4.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "prisma": "^6.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
