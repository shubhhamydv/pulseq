NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://jobs:jobs@localhost:5433/jobs?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
OTEL_ENABLED=false
OTEL_SERVICE_NAME=pulseq-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
WORKER_CONCURRENCY=10
WORKER_BATCH_LIMIT=10
WORKER_POLL_INTERVAL_MS=1000
WORKER_LOCK_TTL_MS=30000
WORKER_PROCESSING_LEASE_MS=60000
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_HEARTBEAT_TIMEOUT_MS=20000
SCHEDULER_POLL_INTERVAL_MS=1000
